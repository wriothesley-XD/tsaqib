<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <linearGradient id="grad-default" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#01795F" />
      <stop offset="100%" stop-color="#3F704D" />
    </linearGradient>
    <filter id="shadow-default" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-opacity="0.25"/>
    </filter>
  </defs>
  <!-- Background Circle -->
  <circle cx="100" cy="100" r="94" fill="url(#grad-default)" stroke="#FFFFFF" stroke-width="6"/>
  <!-- Decorative Ring -->
  <circle cx="100" cy="100" r="82" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="2" stroke-dasharray="6,4"/>
  <!-- Character Head Silhouette Placeholder -->
  <circle cx="100" cy="82" r="38" fill="#FFFFFF" fill-opacity="0.9" filter="url(#shadow-default)"/>
  <!-- Character Body Silhouette Placeholder -->
  <path d="M 52,165 C 52,125 148,125 148,165 Z" fill="#FFFFFF" fill-opacity="0.9" filter="url(#shadow-default)"/>
  <!-- Community Badge Icon -->
  <circle cx="100" cy="95" r="22" fill="#01795F" stroke="#FFFFFF" stroke-width="3"/>
  <text x="100" y="103" font-size="20" text-anchor="middle" dominant-baseline="central">🕌</text>
</svg>